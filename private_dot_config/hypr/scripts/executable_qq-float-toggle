#!/bin/bash
# qq-float 显示/隐藏开关:pin 窗口需先解除 pin 才能藏进 special 工作区
INFO=$(hyprctl clients -j | jq -r '.[] | select(.class == "qq-float") | "\(.address) \(.pinned) \(.workspace.name)"' | head -1)
if [ -z "$INFO" ]; then exec qq-float; fi   # 未运行则启动
ADDR=$(echo "$INFO" | cut -d' ' -f1)
WS=$(echo "$INFO" | cut -d' ' -f3)
if [ "$WS" != "special:qq" ]; then
    echo "$WS" > /tmp/qq-float-home
    hyprctl dispatch 'hl.dsp.window.pin({ window = "address:'$ADDR'", action = "disable" })' > /dev/null
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$ADDR\", workspace = \"special:qq\", follow = false })" > /dev/null
else
    HOME_WS=$(cat /tmp/qq-float-home 2>/dev/null || echo 1)
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$ADDR\", workspace = \"$HOME_WS\" })" > /dev/null
    hyprctl dispatch 'hl.dsp.window.pin({ window = "address:'$ADDR'", action = "enable" })' > /dev/null
fi
